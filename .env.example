# The Jinyang Pact - runtime configuration.
# Copy to .env and edit (copy .env.example .env). .env is gitignored: never commit, paste or share it.
# All variables are optional; the defaults below apply when a line is absent or commented out.
# Variables already set in the shell take precedence over .env.
# Put comments on their own lines (no inline "# ..." after a value).

# ---------------------------------------------------------------------------
# Provider
# ---------------------------------------------------------------------------
# mock (default): deterministic offline mock LLM, no network.
# openrouter: real calls to OpenRouter. Entry points that can reach the network additionally
# require the explicit --live flag, e.g.  npm run live:smoke -- --live
LLM_PROVIDER=mock

# Your OpenRouter API key (only needed for LLM_PROVIDER=openrouter). The program reads it only from
# the environment / this file and redacts it from every log, error and output file.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Models per role (OpenRouter slugs). Default for every role: deepseek/deepseek-v4-flash
# (the smoke role uses MODEL_CHARACTER). The Judge may use deepseek/deepseek-v4-pro.
# ---------------------------------------------------------------------------
# MODEL_CHARACTER=deepseek/deepseek-v4-flash
# MODEL_JUDGE=deepseek/deepseek-v4-flash
# MODEL_NARRATOR=deepseek/deepseek-v4-flash
# MODEL_MAPPER=deepseek/deepseek-v4-flash
# MODEL_RATER=deepseek/deepseek-v4-flash

# ---------------------------------------------------------------------------
# Sampling temperature (0..2). LLM_TEMPERATURE sets every role; LLM_TEMPERATURE_<ROLE> overrides
# one role (ROLE = CHARACTER, JUDGE, NARRATOR, MAPPER, RATER, SMOKE).
# Defaults: character 0.7, narrator 0.7, judge 0.2, mapper 0.2, rater 0.2, smoke 0.2
# ---------------------------------------------------------------------------
# LLM_TEMPERATURE=
# LLM_TEMPERATURE_CHARACTER=0.7
# LLM_TEMPERATURE_JUDGE=0.2
# LLM_TEMPERATURE_NARRATOR=0.7
# LLM_TEMPERATURE_MAPPER=0.2
# LLM_TEMPERATURE_RATER=0.2
# LLM_TEMPERATURE_SMOKE=0.2

# ---------------------------------------------------------------------------
# Output cap per role (max_tokens, integer). Reasoning tokens count toward it.
# LLM_MAX_TOKENS sets every role; LLM_MAX_TOKENS_<ROLE> overrides one role.
# Defaults: character 700, judge 500, narrator 900, mapper 300, rater 500, smoke 300
# ---------------------------------------------------------------------------
# LLM_MAX_TOKENS=
# LLM_MAX_TOKENS_CHARACTER=700
# LLM_MAX_TOKENS_JUDGE=500
# LLM_MAX_TOKENS_NARRATOR=900
# LLM_MAX_TOKENS_MAPPER=300
# LLM_MAX_TOKENS_RATER=500
# LLM_MAX_TOKENS_SMOKE=300

# ---------------------------------------------------------------------------
# Input guard per role: maximum total characters of a request's messages. A larger request fails
# fast with error kind "config" (no API call). LLM_MAX_INPUT_CHARS sets every role.
# Defaults (PLAN section 9): character 32000 (prompts are trimmed to about 24000), judge 16000, narrator 12000,
# mapper 8000; rater 48000, smoke 8000
# ---------------------------------------------------------------------------
# LLM_MAX_INPUT_CHARS=
# LLM_MAX_INPUT_CHARS_CHARACTER=32000
# LLM_MAX_INPUT_CHARS_JUDGE=16000
# LLM_MAX_INPUT_CHARS_NARRATOR=12000
# LLM_MAX_INPUT_CHARS_MAPPER=8000
# LLM_MAX_INPUT_CHARS_RATER=48000
# LLM_MAX_INPUT_CHARS_SMOKE=8000

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
# Per-attempt timeout in ms (1000..600000). A timed-out attempt is not retried.
# LLM_TIMEOUT_MS=60000
# HTTP retries for 408/409/429/5xx and network errors (0..10); backoff 1 s, 2 s, 4 s, ... with +/-20 % jitter
# (a Retry-After header is honoured, capped at 30 s).
# Parse/schema failures always get exactly one repair retry (not configurable).
# LLM_HTTP_RETRIES=2

# json_schema (default): strict structured outputs, sent with provider.require_parameters=true.
# json_object: plain JSON mode; the schema is described in the system prompt instead
# (fallback if no provider serves strict json_schema for the chosen model).
# LLM_RESPONSE_FORMAT=json_schema

# Unified OpenRouter reasoning parameter:
#   off (default)       -> reasoning: { enabled: false }
#   low | medium | high -> reasoning: { effort: <level> }
#   default             -> parameter omitted (model default)
# Reasoning tokens are billed as output and count toward max_tokens: raise LLM_MAX_TOKENS_* first.
# OPENROUTER_REASONING=off

# Optional comma-separated OpenRouter provider slugs to exclude, for all roles.
# Default: no exclusions. Use documented slugs, e.g. atlas-cloud (not the display label AtlasCloud).
# Exclusions are recorded in smoke reports, experiment plan.json and the freeze manifest.
# Compatibility diagnostic example (not a prompt-tuning iteration):
# OPENROUTER_PROVIDER_IGNORE=atlas-cloud

# ---------------------------------------------------------------------------
# Budget per session (= per experiment run; PLAN section 9: 100 calls, US$0.50). Enforced before every
# call: a worst-case cost is reserved atomically (safe for parallel calls) and reconciled with the
# reported or estimated cost afterwards; an unknown cost is charged at the reserved worst case.
# ---------------------------------------------------------------------------
# BUDGET_MAX_CALLS_PER_SESSION=100
# BUDGET_MAX_USD_PER_SESSION=0.50

# Price bounds in USD per million input/output tokens. Every live request carries them as
# provider.max_price (endpoints above the bound are not used); the budget reserves worst cases and
# estimates unreported costs with them. Built in (OpenRouter listings 2026-09-27):
#   deepseek/deepseek-v4-flash=0.15/0.30   deepseek/deepseek-v4-pro=0.40/0.80
# Live calls to any other model are refused until you add a bound here (comma-separated entries):
# LLM_PRICE_BOUNDS=vendor/model=1.0/2.0

# ---------------------------------------------------------------------------
# Narrative and character-dialogue language: zh (default) | en
# ---------------------------------------------------------------------------
# NARRATIVE_LANG=zh
